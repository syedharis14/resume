        "eslint": "^9.23.0",
        "eslint-config-prettier": "^10.1.1",
        "eslint-plugin-prettier": "^5.2.5",
        "eslint-plugin-vue": "^10.0.0",
        "gh-pages": "^6.3.0",
        "husky": "^8.0.0",
        "lint-staged": "^15.5.0",
        "lucide-vue-next": "^0.484.0",
        "prettier": "^3.5.3",
        "puppeteer": "^24.4.0",
        "serve": "^14.2.4",
        "style-loader": "^4.0.0",
